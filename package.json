{
  "name": "nova",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri dev",
    "tauri:build": "tauri build --ignore-version-mismatches",
    "tauri:win:build": "tauri build --target x86_64-pc-windows-msvc --ignore-version-mismatches",
    "tauri:linux:build": "tauri build --target x86_64-unknown-linux-gnu --ignore-version-mismatches",
    "build:cli": "cargo build -p nova-cli --release",
    "sync:cli": "node scripts/sync-cli.js",
    "gen:bindings": "node scripts/gen-bindings.js",
    "check:contract": "node scripts/check-contract.js",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.70.0",
    "@tanstack/vue-virtual": "^3.13.35",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vueuse/core": "^14.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^2.1.10"
  }
}
